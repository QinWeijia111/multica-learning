---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  mainClass?: string;
}

const {
  title,
  description = '从真实源代码出发理解 Multica',
  mainClass,
} = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeUrl = `${basePath}/`;
const faviconUrl = `${basePath}/favicon.svg`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <a class="brand" href={homeUrl}>Multica Learning</a>
      <nav aria-label="主导航">
        <a href={homeUrl}>首页</a>
        <a
          class="nav-github"
          href="https://github.com/QinWeijia111/multica-learning"
          aria-label="项目 GitHub 仓库"
          target="_blank"
          rel="noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.24c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.58-.29-5.29-1.29-5.29-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.48.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.19-1.49 3.16-1.18 3.16-1.18.63 1.57.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.41-2.72 5.39-5.3 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
          </svg>
          <span>GitHub</span>
        </a>
      </nav>
    </header>
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
    <footer>以源代码为依据，循序理解 Multica。</footer>
  </body>
</html>
