---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const chapters = (await getCollection('tutorials')).sort(
  (left, right) => left.data.order - right.data.order,
);
const firstChapter = chapters[0];
const latestChapter = chapters.at(-1);
const chapterUrl = (slug: string) => `${basePath}/learn/${slug}/`;
---

<BaseLayout title="Multica Learning · 从源码理解 Multica">
  <section class="hero">
    <p class="eyebrow">SOURCE-CODE LEARNING</p>
    <h1>从源代码出发，理解 Multica</h1>
    <p class="lede">
      面向中文读者的 Multica 架构与实现学习指南。所有技术解释都将回到真实代码、调用链与可验证的实验。
    </p>
    <div class="actions">
      {firstChapter && <a class="button" href={chapterUrl(firstChapter.data.slug)}>开始阅读</a>}
      <a class="text-link" href="#published-chapters">查看全部章节</a>
    </div>
  </section>

  <section class="chapter-catalogue" id="published-chapters" aria-labelledby="published-chapters-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PUBLISHED CHAPTERS</p>
        <h2 id="published-chapters-title">已发布章节</h2>
      </div>
      <p class="catalogue-summary">
        已发布 {chapters.length} 个源码章节
        {latestChapter && <> · 最新 {latestChapter.data.module}</>}
      </p>
    </div>

    <ol class="chapter-cards">
      {chapters.map((chapter) => (
        <li>
          <a href={chapterUrl(chapter.data.slug)}>
            <span class="chapter-card__module">{chapter.data.module}</span>
            <h3>{chapter.data.title}</h3>
            <p>{chapter.data.description}</p>
            <span class="chapter-card__action" aria-hidden="true">阅读章节 →</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
