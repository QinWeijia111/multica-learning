---
import ProjectStatus from '../components/ProjectStatus';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Multica Learning">
  <section class="hero">
    <p class="eyebrow">SOURCE-CODE LEARNING</p>
    <h1>从源代码出发，理解 Multica</h1>
    <p class="lede">
      面向中文读者的 Multica 架构与实现学习指南。所有技术解释都将回到真实代码、调用链与可验证的实验。
    </p>
    <div class="actions">
      <a class="button" href="/learn/getting-started">查看占位学习页</a>
      <a class="text-link" href="https://github.com/QinWeijia111/multica-learning">浏览仓库</a>
    </div>
  </section>
  <ProjectStatus />
</BaseLayout>
